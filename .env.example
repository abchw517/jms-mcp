# JumpServer 主机根地址；不要附加 /api/v1。
jumpserver_url=https://jumpserver.example.com
# 登录访问Token用Bearer；私有Token用Token。不要填真实值到公开仓库。
# Docker --env-file 模式不要给值加引号；Bearer与Token之间保留空格。
api_token=Bearer REPLACE_WITH_JUMPSERVER_TOKEN
auth_scheme=Bearer
# 独立的MCP入站密钥，不带Bearer前缀。
api_key=REPLACE_WITH_RANDOM_MCP_KEY
jms_org_id=

server_host=0.0.0.0
server_port=8099
base_path=/sse
# 跨主机访问时，追加MCP服务器的实际IP或域名，例如192.168.1.10:*。
allowed_hosts=127.0.0.1:*,localhost:*,[::1]:*
allowed_origins=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
allow_unauthenticated=false
tls_verify=true
ca_bundle=
trust_env=false

read_only=true
include_paths=/api/v1/assets/*
include_operations=
exclude_operations=
include_tags=
max_tools=100
request_timeout=30
max_concurrency=8
max_response_bytes=1048576
max_schema_bytes=16777216
log_level=INFO
# 可选，同源Swagger地址。默认 <jumpserver_url>/api/swagger.json。
swagger_url=
